# ==============================================================================
# AI Finance Lakehouse - Environment Configuration
# Copy this file to `.env` and fill in what you have. EVERYTHING IS OPTIONAL:
# the pipeline runs 100% offline with a local DuckDB warehouse + file-based
# event broker when no cloud credentials are provided.
# ==============================================================================

# ---------------------------- LLM PROVIDERS (all free tiers) ------------------
# Router order can be changed. First key that works wins; on HTTP 429/quota it
# automatically fails over to the next provider.
LLM_PROVIDER_ORDER=groq,gemini,mistral,openrouter

GROQ_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Optional model name overrides
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-flash-latest
MISTRAL_MODEL=mistral-small-latest
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ---------------------------- STREAMING: Upstash Kafka ------------------------
# Create free account at https://upstash.com -> Kafka -> REST tab.
# Leave empty to use the built-in local file broker (offline dev mode).
UPSTASH_KAFKA_REST_URL=
UPSTASH_KAFKA_REST_USERNAME=
UPSTASH_KAFKA_REST_PASSWORD=
KAFKA_TOPIC=finance.transactions

# ---------------------------- DATA LAKE: Azure Blob / ADLS Gen2 ---------------
# Leave empty to keep bronze files on local disk under data/lake/.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTAINER=lakehouse-bronze

# ---------------------------- WAREHOUSES --------------------------------------
# Local DuckDB is always used as the primary warehouse (zero config).
DUCKDB_PATH=data/warehouse.duckdb

# Neon Postgres / Supabase serverless free tier
POSTGRES_DSN=

# MotherDuck (DuckDB cloud) free developer plan
MOTHERDUCK_TOKEN=

# Google BigQuery Sandbox (no credit card needed)
BIGQUERY_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=

# Azure SQL / MS SQL Server (12-month free tier) - pyodbc required
MSSQL_DSN=

# ---------------------------- SHAREPOINT SOURCE -------------------------------
# Leave empty to ingest from local data/sources_files/sharepoint_export/ folder
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_SITE_HOST=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_FOLDER_PATH=finance-exports

# ---------------------------- SERVING -----------------------------------------
# Power BI "Publish to web (public)" iframe src URL, e.g.
# https://app.powerbi.com/view?r=eyJ...
POWERBI_EMBED_URL=

# Simulated transaction volume per day (keep modest for free tiers)
SIM_TXNS_PER_DAY=25
